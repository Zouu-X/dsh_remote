    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@dsh-remote/adapter-deepseek": "workspace:*",
    "@dsh-remote/auth-core": "workspace:*",
    "@dsh-remote/domain": "workspace:*",
    "@dsh-remote/protocol": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "license": "MIT"
}
