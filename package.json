{
  "name": "dsh-remote-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:mobile": "pnpm --filter @dsh-remote/mobile-web dev",
    "dev:host": "pnpm --filter @dsh-remote/remote-host dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "license": "MIT"
}
