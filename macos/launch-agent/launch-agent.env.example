# Copy this file to launch-agent.env and edit it before running install.sh.
# The install script only reads launch-agent.env; it does not read .env files
# in the repository root.

# Base URL of DeepSeek Harness. Keep loopback.
DSH_REMOTE_HARNESS_URL=http://127.0.0.1:3080

# Remote Host Adapter listen port (must match your Tailscale Serve target).
DSH_REMOTE_PORT=3090

# Comma-separated Tailscale device IDs allowed to connect.
# Empty means every device signed in to the same tailnet is allowed.
DSH_REMOTE_ALLOWED_DEVICE_IDS=

# How often (seconds) the LaunchAgent checks whether Harness is listening.
DSH_REMOTE_HARNESS_POLL_SECONDS=15

# off: never keep awake; auto: keep awake only while sessions are running.
DSH_REMOTE_CAFFEINATE=auto

# tailscale: resolve remote devices from `tailscale status --json`;
# none: reject non-loopback remote access.
DSH_REMOTE_IDENTITY_PROVIDER=tailscale

# mac-keychain: store the host device private key in macOS Keychain;
# none: disable key storage (testing only).
DSH_REMOTE_SECRET_STORE=mac-keychain

# MagicDNS hostname passed to the optional Harness supervisor.
# Leave empty to auto-detect from `tailscale status --json`.
DSH_REMOTE_TRUSTED_HOST=

# Set to 1 to install the optional Harness supervisor LaunchAgent.
# Default is 0: start Harness manually; the Remote Host LaunchAgent follows it.
DSH_INSTALL_HARNESS_SUPERVISOR=0
